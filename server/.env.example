# Copy this file to .env and fill in the values before starting the backend.

GOOGLE_API_KEY=your-google-api-key
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=your-pinecone-index-name
# Optional: use this when your Pinecone deployment must connect through a custom controller host
# PINECONE_CONTROLLER_HOST=https://controller.<region>.pinecone.io
PORT=5000
